# .env.example  (local development; on Railway set these in the service's Variables tab instead)
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use local SQLite. On Railway: ${{Postgres.DATABASE_URL}} (or your Neon URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Railway / production only ---
# Railway fills RAILWAY_PUBLIC_DOMAIN and RAILWAY_VOLUME_MOUNT_PATH automatically, so ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS only need setting for a custom domain, e.g.:
# ALLOWED_HOSTS=chat.example.com
# CSRF_TRUSTED_ORIGINS=https://chat.example.com
# REDIS_URL=${{Redis.REDIS_URL}}     # only if you run more than one process/replica
# MEDIA_ROOT=/data/media             # only to override the Volume path
# LOG_LEVEL=WARNING

# Video calls (optional). STUN works out of the box; add a hosted TURN server so calls also connect
# behind strict NATs. Railway cannot host a UDP TURN server itself.
# CALL_TURN_URLS=turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# CALL_TURN_SECRET=the-coturn-static-auth-secret
# CALL_TURN_USERNAME=
# CALL_TURN_CREDENTIAL=
